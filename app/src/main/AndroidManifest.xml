<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 相機：預覽 / 高幀率錄影 / 逐幀分析 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 麥克風：錄影時同步收音（可選權限，缺失時靜音錄製） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- API 28 及以下寫外部儲存 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- API 33+ 讀取已錄製影片（相冊/分享） -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 高幀率錄影依賴硬件能力，但App可在一般裝置降級到 30fps -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".PitchLabApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.PitchLab"
        tools:targetApi="34">

        <!-- 逐幀分析需要大內存（720p RGBA + OpenCV Mat），largeHeap 已開啓 -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PitchLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            錄影片段要交給外部播放器開啟，Android 7+ 必須走 FileProvider，
            不能再直接傳 file:// URI（會拋 FileUriExposedException）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Hilt 生成的元件無須額外宣告；此處僅保持 tools 命名空間可用 -->
        <meta-data
            android:name="com.pitchlab.PHASE"
            android:value="10" />
    </application>
</manifest>
