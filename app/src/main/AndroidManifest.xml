<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 相机：预览 / 高帧率录像 / 逐帧分析 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 麦克风：录像时同步收音（可选权限，缺失时静音录制） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- API 28 及以下写外部存储 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- API 33+ 读取已录制视频（相册/分享） -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 高帧率录像依赖硬件能力，但应用可在普通设备降级到 30fps -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".PitchLabApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.PitchLab"
        tools:targetApi="34">

        <!-- 逐帧分析需要大内存（720p RGBA + OpenCV Mat），largeHeap 已开启 -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PitchLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hilt 生成的组件无需额外声明；此处仅保持 tools 命名空间可用 -->
        <meta-data
            android:name="com.pitchlab.PHASE"
            android:value="1" />
    </application>
</manifest>
